<!DOCTYPE html>

<html lang="zh">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>大富翁投资学 · 互动经济地图</title>

<link rel="preconnect" href="https://fonts.googleapis.com">

<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&family=Noto+Sans+SC:wght@300;400;500&family=ZCOOL+XiaoWei&display=swap" rel="stylesheet">

<style>

/* ===================== ROOT VARIABLES ===================== */

:root {

  --parchment: #f4edd8;

  --parchment-dark: #e8d9b5;

  --parchment-shadow: #c9b98a;

  --ink: #2c1810;

  --ink-light: #5c3d2e;

  --ink-faint: #9c7b6b;

  --gold: #c9922a;

  --gold-light: #e8b84b;

  --gold-dark: #8b6520;



  --purple-zone: #6b3fa0;

  --ltblue-zone: #2980b9;

  --pink-zone: #d63384;

  --orange-zone: #e07b2a;

  --red-zone: #c0392b;

  --yellow-zone: #c9a227;

  --green-zone: #27ae60;

  --dkblue-zone: #1a3a6b;



  --panel-bg: rgba(244,237,216,0.97);

  --border-ornate: 2px solid var(--gold);

  --shadow-paper: 0 8px 32px rgba(44,24,16,0.18), 0 2px 8px rgba(44,24,16,0.10);

  --radius: 4px;



  --font-title: 'ZCOOL XiaoWei', 'Noto Serif SC', serif;

  --font-body: 'Noto Sans SC', sans-serif;

  --font-serif: 'Noto Serif SC', serif;

}



/* ===================== RESET & BASE ===================== */

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { font-size: 14px; }

body {

  background: #1a0f0a;

  background-image:

    radial-gradient(ellipse at 20% 50%, rgba(100,60,20,0.3) 0%, transparent 60%),

    radial-gradient(ellipse at 80% 50%, rgba(60,30,10,0.3) 0%, transparent 60%);

  min-height: 100vh;

  font-family: var(--font-body);

  color: var(--ink);

  overflow-x: hidden;

}



/* ===================== HEADER ===================== */

#header {

  text-align: center;

  padding: 1.5rem 1rem 1rem;

  position: relative;

}

#header::before {

  content: '❧ ❧ ❧';

  display: block;

  color: var(--gold);

  font-size: 1.2rem;

  margin-bottom: .5rem;

  letter-spacing: .5rem;

}

#header h1 {

  font-family: var(--font-title);

  font-size: clamp(1.6rem, 3vw, 2.4rem);

  color: var(--gold-light);

  text-shadow: 0 2px 8px rgba(0,0,0,0.5);

  letter-spacing: .15em;

  line-height: 1.2;

}

#header p {

  color: #c9b98a;

  font-size: .85rem;

  margin-top: .4rem;

  letter-spacing: .05em;

}



/* ===================== APP LAYOUT ===================== */

#app {

  display: grid;

  grid-template-columns: 1fr 380px;

  grid-template-rows: auto 1fr;

  gap: 1.25rem;

  max-width: 1280px;

  margin: 0 auto;

  padding: 0 1rem 2rem;

  min-height: calc(100vh - 120px);

}



/* ===================== BOARD CONTAINER ===================== */

#board-wrap {

  grid-column: 1;

  grid-row: 1 / 3;

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 1rem;

}



/* ===================== MONOPOLY BOARD ===================== */

#board {

  background: var(--parchment);

  border: 3px solid var(--gold-dark);

  box-shadow: var(--shadow-paper), inset 0 0 40px rgba(180,140,60,0.08);

  position: relative;

  display: grid;

  grid-template-columns: 72px repeat(9, 1fr) 72px;

  grid-template-rows: 72px repeat(9, 1fr) 72px;

  width: 100%;

  max-width: 660px;

  aspect-ratio: 1;

}



/* Board center */

#board-center {

  grid-column: 2 / 11;

  grid-row: 2 / 11;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  padding: 1rem;

  text-align: center;

  border: 1px solid var(--parchment-shadow);

  background: linear-gradient(135deg, rgba(244,237,216,0.6) 0%, rgba(232,217,181,0.6) 100%);

  position: relative;

  overflow: hidden;

}

#board-center::before {

  content: '';

  position: absolute;

  inset: 8px;

  border: 1px solid var(--gold);

  opacity: 0.3;

  pointer-events: none;

}

.center-title {

  font-family: var(--font-title);

  font-size: clamp(1rem, 2vw, 1.4rem);

  color: var(--gold-dark);

  line-height: 1.3;

  margin-bottom: .5rem;

}

.center-subtitle {

  font-size: .72rem;

  color: var(--ink-faint);

  line-height: 1.6;

  max-width: 280px;

}

.center-legend {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 4px 10px;

  margin-top: .75rem;

  text-align: left;

}

.leg-item {

  display: flex;

  align-items: center;

  gap: 5px;

  font-size: .68rem;

  color: var(--ink-light);

  cursor: pointer;

  padding: 2px 4px;

  border-radius: 2px;

  transition: background .15s;

}

.leg-item:hover { background: rgba(201,146,42,0.12); }

.leg-dot {

  width: 9px; height: 9px;

  border-radius: 2px;

  flex-shrink: 0;

}



/* ===================== BOARD CELLS ===================== */

.cell {

  border: 0.5px solid var(--parchment-shadow);

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  cursor: pointer;

  position: relative;

  transition: filter .15s, transform .1s;

  overflow: hidden;

  background: var(--parchment);

  padding: 2px;

}

.cell:hover {

  filter: brightness(1.05);

  z-index: 10;

  transform: scale(1.04);

  box-shadow: 0 2px 12px rgba(44,24,16,0.25);

}

.cell.active {

  outline: 2.5px solid var(--gold);

  outline-offset: -2px;

  z-index: 20;

}



/* Color stripe on top of property cells */

.cell-stripe {

  position: absolute;

  top: 0; left: 0; right: 0;

  height: 10px;

  flex-shrink: 0;

}

/* Left side cells: stripe on right */

.cell-left .cell-stripe { top: 0; left: auto; right: 0; bottom: 0; width: 10px; height: auto; }

/* Right side cells: stripe on left */

.cell-right .cell-stripe { top: 0; right: auto; left: 0; bottom: 0; width: 10px; height: auto; }

/* Top row: stripe on bottom */

.cell-top .cell-stripe { top: auto; bottom: 0; left: 0; right: 0; height: 10px; width: auto; }



.cell-name {

  font-size: .56rem;

  font-family: var(--font-serif);

  color: var(--ink-light);

  text-align: center;

  line-height: 1.3;

  padding: 1px 2px;

  margin-top: 2px;

}

.cell-icon { font-size: 1rem; line-height: 1; }

.cell-price {

  font-size: .52rem;

  color: var(--ink-faint);

  margin-top: 1px;

}



/* Corner cells */

.cell-corner {

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  background: var(--parchment-dark);

  border: 1px solid var(--parchment-shadow);

}

.cell-corner .corner-icon { font-size: 1.5rem; }

.cell-corner .corner-label {

  font-size: .6rem;

  font-family: var(--font-serif);

  color: var(--ink-light);

  text-align: center;

  line-height: 1.3;

  margin-top: 2px;

}



/* Special cells */

.cell-railroad .cell-icon { font-size: 1.1rem; }

.cell-utility .cell-icon { font-size: 1.1rem; }

.cell-chance { background: linear-gradient(135deg, #fff8e1, #ffe082); }

.cell-chest { background: linear-gradient(135deg, #e8f5e9, #a5d6a7); }

.cell-tax { background: linear-gradient(135deg, #fce4ec, #f48fb1); }



/* Zone colors */

.zone-purple  { background-color: var(--purple-zone) !important; }

.zone-ltblue  { background-color: var(--ltblue-zone) !important; }

.zone-pink    { background-color: var(--pink-zone) !important; }

.zone-orange  { background-color: var(--orange-zone) !important; }

.zone-red     { background-color: var(--red-zone) !important; }

.zone-yellow  { background-color: var(--yellow-zone) !important; }

.zone-green   { background-color: var(--green-zone) !important; }

.zone-dkblue  { background-color: var(--dkblue-zone) !important; }



/* ===================== SIDE PANEL ===================== */

#panel {

  grid-column: 2;

  grid-row: 1 / 3;

  display: flex;

  flex-direction: column;

  gap: 1rem;

}



/* Panel card base */

.pcard {

  background: var(--panel-bg);

  border: var(--border-ornate);

  border-radius: var(--radius);

  box-shadow: var(--shadow-paper);

  overflow: hidden;

}

.pcard-head {

  background: linear-gradient(135deg, var(--gold-dark), var(--gold));

  padding: .6rem 1rem;

  display: flex;

  align-items: center;

  gap: .5rem;

}

.pcard-head h2 {

  font-family: var(--font-title);

  font-size: 1rem;

  color: var(--parchment);

  letter-spacing: .05em;

}

.pcard-head .head-icon { font-size: 1.1rem; }

.pcard-body { padding: .85rem 1rem; }



/* ===================== INFO PANEL ===================== */

#info-panel { flex-shrink: 0; }

#info-default {

  text-align: center;

  padding: 1.5rem .5rem;

  color: var(--ink-faint);

}

#info-default .idle-icon { font-size: 2.5rem; margin-bottom: .5rem; }

#info-default p { font-size: .8rem; line-height: 1.6; }

#info-content { display: none; }



.info-zone-bar {

  height: 8px;

  border-radius: 2px;

  margin-bottom: .75rem;

}

.info-name {

  font-family: var(--font-title);

  font-size: 1.15rem;

  color: var(--ink);

  margin-bottom: .25rem;

}

.info-invest-tag {

  display: inline-flex;

  align-items: center;

  gap: 5px;

  font-size: .72rem;

  color: #fff;

  padding: 3px 8px;

  border-radius: 3px;

  margin-bottom: .75rem;

}

.info-section { margin-bottom: .75rem; }

.info-section-title {

  font-size: .68rem;

  font-weight: 600;

  color: var(--gold-dark);

  text-transform: uppercase;

  letter-spacing: .08em;

  margin-bottom: .3rem;

  padding-bottom: .2rem;

  border-bottom: 1px solid var(--parchment-shadow);

}

.info-section p {

  font-size: .78rem;

  color: var(--ink-light);

  line-height: 1.65;

}

.info-stats {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 6px;

  margin-top: .5rem;

}

.info-stat {

  background: var(--parchment-dark);

  border-radius: 3px;

  padding: .4rem .6rem;

  text-align: center;

}

.info-stat-val {

  font-family: var(--font-serif);

  font-size: .9rem;

  font-weight: 600;

  color: var(--ink);

}

.info-stat-label {

  font-size: .62rem;

  color: var(--ink-faint);

  margin-top: 1px;

}

.moat-badges {

  display: flex;

  flex-wrap: wrap;

  gap: 4px;

  margin-top: .4rem;

}

.moat-badge {

  font-size: .65rem;

  padding: 2px 7px;

  border-radius: 10px;

  background: var(--parchment-dark);

  color: var(--ink-light);

  border: 0.5px solid var(--parchment-shadow);

}



/* ===================== LESSON PANEL ===================== */

#lesson-panel { flex: 1; overflow: hidden; display: flex; flex-direction: column; }

.lesson-tabs {

  display: flex;

  overflow-x: auto;

  background: var(--parchment-dark);

  border-bottom: 1px solid var(--parchment-shadow);

  scrollbar-width: none;

  flex-shrink: 0;

}

.lesson-tabs::-webkit-scrollbar { display: none; }

.ltab {

  flex-shrink: 0;

  padding: .45rem .7rem;

  font-size: .7rem;

  color: var(--ink-faint);

  cursor: pointer;

  border-bottom: 2px solid transparent;

  transition: all .15s;

  white-space: nowrap;

  font-family: var(--font-serif);

}

.ltab:hover { color: var(--ink); background: rgba(201,146,42,0.08); }

.ltab.active {

  color: var(--gold-dark);

  border-bottom-color: var(--gold);

  background: var(--panel-bg);

}

.lesson-content {

  padding: .85rem 1rem;

  overflow-y: auto;

  flex: 1;

  font-size: .78rem;

  line-height: 1.7;

  color: var(--ink-light);

}

.lesson-content h3 {

  font-family: var(--font-title);

  font-size: 1rem;

  color: var(--ink);

  margin-bottom: .5rem;

}

.lesson-content h4 {

  font-size: .78rem;

  font-weight: 600;

  color: var(--gold-dark);

  margin: .75rem 0 .3rem;

  text-transform: uppercase;

  letter-spacing: .05em;

}

.lesson-content p { margin-bottom: .5rem; }

.concept-card {

  background: var(--parchment-dark);

  border-left: 3px solid var(--gold);

  padding: .5rem .7rem;

  margin: .5rem 0;

  border-radius: 0 3px 3px 0;

  font-size: .76rem;

}

.concept-card strong {

  display: block;

  color: var(--ink);

  margin-bottom: 2px;

  font-family: var(--font-serif);

}

.compare-table {

  width: 100%;

  border-collapse: collapse;

  font-size: .72rem;

  margin: .5rem 0;

}

.compare-table th {

  background: var(--parchment-dark);

  padding: .3rem .5rem;

  text-align: left;

  font-weight: 600;

  color: var(--gold-dark);

  border-bottom: 1px solid var(--parchment-shadow);

}

.compare-table td {

  padding: .28rem .5rem;

  border-bottom: 0.5px solid var(--parchment-shadow);

  color: var(--ink-light);

}

.compare-table tr:last-child td { border-bottom: none; }

.tag-row {

  display: flex; flex-wrap: wrap; gap: 4px; margin: .4rem 0;

}

.tag {

  font-size: .65rem;

  padding: 2px 8px;

  border-radius: 10px;

  border: 0.5px solid currentColor;

}



/* ===================== BOTTOM TOOL BAR ===================== */

#toolbar {

  grid-column: 1 / 3;

  grid-row: 3;

  display: flex;

  justify-content: center;

  gap: .75rem;

  flex-wrap: wrap;

  padding: .5rem 0;

}

.tool-btn {

  background: rgba(201,146,42,0.12);

  border: 1px solid var(--gold-dark);

  color: var(--gold-light);

  font-family: var(--font-serif);

  font-size: .78rem;

  padding: .45rem 1rem;

  border-radius: 3px;

  cursor: pointer;

  transition: all .15s;

  letter-spacing: .05em;

}

.tool-btn:hover {

  background: rgba(201,146,42,0.25);

  color: var(--parchment);

}

.tool-btn.active {

  background: var(--gold-dark);

  color: var(--parchment);

}



/* ===================== MODAL ===================== */

#modal-overlay {

  display: none;

  position: fixed;

  inset: 0;

  background: rgba(20,10,5,0.75);

  z-index: 100;

  align-items: center;

  justify-content: center;

  padding: 1rem;

}

#modal-overlay.open { display: flex; }

#modal {

  background: var(--parchment);

  border: 2px solid var(--gold);

  border-radius: var(--radius);

  max-width: 560px;

  width: 100%;

  max-height: 85vh;

  overflow-y: auto;

  box-shadow: 0 20px 60px rgba(0,0,0,0.5);

  animation: modalIn .2s ease;

}

@keyframes modalIn {

  from { opacity: 0; transform: translateY(20px) scale(.97); }

  to   { opacity: 1; transform: translateY(0) scale(1); }

}

.modal-head {

  background: linear-gradient(135deg, var(--gold-dark), var(--gold));

  padding: .85rem 1.25rem;

  display: flex;

  align-items: center;

  justify-content: space-between;

}

.modal-head h2 {

  font-family: var(--font-title);

  font-size: 1.1rem;

  color: var(--parchment);

}

.modal-close {

  background: none;

  border: none;

  color: var(--parchment);

  font-size: 1.3rem;

  cursor: pointer;

  line-height: 1;

  padding: 0 .25rem;

}

.modal-body { padding: 1.25rem; font-size: .82rem; line-height: 1.75; color: var(--ink-light); }

.modal-body h3 { font-family: var(--font-title); color: var(--ink); margin: .75rem 0 .3rem; }

.modal-body p { margin-bottom: .6rem; }

.modal-body blockquote {

  border-left: 3px solid var(--gold);

  padding: .4rem .75rem;

  margin: .6rem 0;

  color: var(--ink);

  font-style: italic;

  background: var(--parchment-dark);

  border-radius: 0 3px 3px 0;

  font-family: var(--font-serif);

}



/* ===================== SCENARIO GAME ===================== */

#scenario-panel {

  display: none;

  grid-column: 1 / 3;

  background: var(--panel-bg);

  border: var(--border-ornate);

  border-radius: var(--radius);

  box-shadow: var(--shadow-paper);

  overflow: hidden;

}

#scenario-panel.show { display: block; }

.scenario-head {

  background: linear-gradient(135deg, #1a3a6b, #2c5aa0);

  padding: .75rem 1.25rem;

  color: var(--parchment);

  font-family: var(--font-title);

  font-size: 1rem;

  display: flex;

  align-items: center;

  justify-content: space-between;

}

.scenario-body { padding: 1rem 1.25rem; }

#scenario-question {

  font-family: var(--font-serif);

  font-size: .88rem;

  color: var(--ink);

  line-height: 1.7;

  margin-bottom: 1rem;

  padding: .75rem;

  background: var(--parchment-dark);

  border-radius: 3px;

  border-left: 3px solid var(--dkblue-zone);

}

.scenario-options { display: flex; flex-direction: column; gap: .5rem; }

.scenario-opt {

  background: var(--parchment);

  border: 1px solid var(--parchment-shadow);

  border-radius: 3px;

  padding: .6rem 1rem;

  font-size: .8rem;

  color: var(--ink-light);

  cursor: pointer;

  transition: all .15s;

  text-align: left;

  font-family: var(--font-body);

}

.scenario-opt:hover { background: var(--parchment-dark); border-color: var(--gold); color: var(--ink); }

.scenario-opt.correct { background: #e8f5e9; border-color: #27ae60; color: #1a5230; }

.scenario-opt.wrong { background: #fce4ec; border-color: #c0392b; color: #7b241c; }

#scenario-feedback {

  display: none;

  margin-top: .75rem;

  padding: .75rem;

  border-radius: 3px;

  font-size: .8rem;

  line-height: 1.65;

}

#scenario-feedback.show { display: block; }

#scenario-feedback.correct-fb { background: #e8f5e9; border-left: 3px solid #27ae60; }

#scenario-feedback.wrong-fb { background: #fce4ec; border-left: 3px solid #c0392b; }

.scenario-nav {

  display: flex;

  gap: .5rem;

  margin-top: .75rem;

  justify-content: flex-end;

}

.scn-btn {

  background: var(--gold-dark);

  border: none;

  color: var(--parchment);

  font-family: var(--font-serif);

  font-size: .78rem;

  padding: .4rem .9rem;

  border-radius: 3px;

  cursor: pointer;

  transition: background .15s;

}

.scn-btn:hover { background: var(--gold); }

.scn-btn:disabled { opacity: .5; cursor: not-allowed; }

#scenario-progress {

  font-size: .7rem;

  color: var(--ink-faint);

  align-self: center;

  flex: 1;

}

#score-display {

  font-family: var(--font-serif);

  font-size: .78rem;

  color: var(--gold-dark);

}



/* ===================== RESPONSIVE ===================== */

@media (max-width: 900px) {

  #app {

    grid-template-columns: 1fr;

    grid-template-rows: auto auto auto;

  }

  #board-wrap { grid-column: 1; grid-row: 1; }

  #panel { grid-column: 1; grid-row: 2; }

  #scenario-panel { grid-column: 1; }

}



/* ===================== SCROLLBAR ===================== */

::-webkit-scrollbar { width: 5px; }

::-webkit-scrollbar-track { background: var(--parchment-dark); }

::-webkit-scrollbar-thumb { background: var(--parchment-shadow); border-radius: 3px; }



/* Entrance animation */

#board { animation: fadeUp .6s ease both; }

#panel { animation: fadeUp .6s ease .15s both; }

@keyframes fadeUp {

  from { opacity: 0; transform: translateY(24px); }

  to   { opacity: 1; transform: translateY(0); }

}



.pulse { animation: pulse 1.5s ease infinite; }

@keyframes pulse {

  0%, 100% { opacity: 1; }

  50% { opacity: .6; }

}

</style>

</head>

<body>



<div id="header">

  <h1>大富翁投资学</h1>

  <p>互动经济地图 · 点击棋盘格子探索投资知识</p>

</div>



<div id="app">



<!-- ========== BOARD ========== -->

<div id="board-wrap">

  <div id="board">

    <!-- Board cells will be injected by JS -->

    <div id="board-center">

      <div class="center-title">大富翁<br>投资学</div>

      <p class="center-subtitle">点击任意格子<br>探索对应的投资知识</p>

      <div class="center-legend" id="center-legend"></div>

    </div>

  </div>



  <!-- Toolbar -->

  <div id="toolbar">

    <button class="tool-btn active" onclick="setMode('explore')">🗺️ 探索模式</button>

    <button class="tool-btn" onclick="setMode('scenario')">🎲 情景挑战</button>

    <button class="tool-btn" onclick="openModal('rules')">📜 棋盘规则</button>

    <button class="tool-btn" onclick="openModal('map')">🌲 森林地图</button>

  </div>

</div>



<!-- ========== SIDE PANEL ========== -->

<div id="panel">



  <!-- Info card -->

  <div class="pcard" id="info-panel">

    <div class="pcard-head">

      <span class="head-icon">📋</span>

      <h2>格子详情</h2>

    </div>

