/* =====================================================================

   SCENARIO GAME

   ===================================================================== */



let scenarioIndex = 0;

let score = 0;

let answered = false;



function setMode(mode) {

  document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));

  event.currentTarget.classList.add('active');



  const sp = document.getElementById('scenario-panel');

  if (mode === 'scenario') {

    sp.classList.add('show');

    loadScenario(0);

  } else {

    sp.classList.remove('show');

  }

}



function loadScenario(i) {

  scenarioIndex = i;

  answered = false;

  const s = SCENARIOS[i];

  document.getElementById('scenario-question').textContent = s.q;

  const opts = document.getElementById('scenario-options');

  opts.innerHTML = '';

  s.opts.forEach((o, idx) => {

    const btn = document.createElement('button');

    btn.className = 'scenario-opt';

    btn.textContent = o.text;

    btn.onclick = () => answerScenario(idx);

    opts.appendChild(btn);

  });

  document.getElementById('scenario-feedback').className = 'scenario-feedback';

  document.getElementById('scenario-feedback').style.display = 'none';

  document.getElementById('scn-next').disabled = true;

  document.getElementById('scenario-progress').textContent = `第 ${i+1} / ${SCENARIOS.length} 题`;

  updateScore();

}



function answerScenario(idx) {

  if (answered) return;

  answered = true;

  const s = SCENARIOS[scenarioIndex];

  const o = s.opts[idx];

  const opts = document.getElementById('scenario-options').children;



  // Highlight all correct/wrong

  s.opts.forEach((opt, i) => {

    if (opt.correct) opts[i].classList.add('correct');

    else if (i === idx && !opt.correct) opts[i].classList.add('wrong');

  });



  if (o.correct) score++;

  updateScore();



  const fb = document.getElementById('scenario-feedback');

  fb.textContent = o.fb;

  fb.className = 'scenario-feedback show ' + (o.correct ? 'correct-fb' : 'wrong-fb');

  fb.style.display = 'block';

  document.getElementById('scn-next').disabled = (scenarioIndex >= SCENARIOS.length - 1);

}



function nextScenario() {

  if (scenarioIndex < SCENARIOS.length - 1) {

    loadScenario(scenarioIndex + 1);

  }

}



function updateScore() {

  document.getElementById('score-display').textContent = `得分：${score} / ${SCENARIOS.length}`;

}



