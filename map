function buildCell(data, dir) {

  const div = document.createElement('div');

  div.className = 'cell';

  if (dir) div.classList.add('cell-' + dir);

  if (data.corner) div.classList.add('cell-corner');



  let html = '';



  if (data.corner) {

    html = `<div class="corner-icon">${data.icon}</div><div class="corner-label">${data.name.replace('\n','<br>')}</div>`;

  } else if (data.type === 'property') {

    const z = ZONES[data.zone];

    html = `<div class="cell-stripe ${data.zone ? 'zone-'+data.zone : ''}"></div>

            <div class="cell-name">${data.name.replace('\n','<br>')}</div>

            <div class="cell-price">¥${data.price}</div>`;

    div.onclick = () => showInfo(data, z);

  } else if (data.type === 'railroad') {

    html = `<div class="cell-icon">${data.icon}</div><div class="cell-name">${data.name.replace('\n','<br>')}</div>`;

    div.onclick = () => showRailroadInfo(data);

    div.classList.add('cell-railroad');

  } else if (data.type === 'utility') {

    html = `<div class="cell-icon">${data.icon}</div><div class="cell-name">${data.name.replace('\n','<br>')}</div>`;

    div.onclick = () => showUtilityInfo(data);

    div.classList.add('cell-utility');

  } else if (data.type === 'chance') {

    html = `<div class="cell-icon">${data.icon}</div><div class="cell-name">${data.name.replace('\n','<br>')}</div>`;

    div.onclick = () => showSpecialInfo('chance');

    div.classList.add('cell-chance');

  } else if (data.type === 'chest') {

    html = `<div class="cell-icon">${data.icon}</div><div class="cell-name">${data.name.replace('\n','<br>')}</div>`;

    div.onclick = () => showSpecialInfo('chest');

    div.classList.add('cell-chest');

  } else if (data.type === 'tax') {

    html = `<div class="cell-icon">${data.icon}</div><div class="cell-name">${data.name.replace('\n','<br>')}</div>`;

    div.onclick = () => showSpecialInfo('tax');

    div.classList.add('cell-tax');

  } else if (data.type === 'corner') {

    html = `<div class="corner-icon">${data.icon}</div><div class="corner-label">${data.name.replace('\n','<br>')}</div>`;

    div.onclick = () => showCornerInfo(data.id);

  }



  div.innerHTML = html;

  return div;

}



function renderBoard() {

  const board = document.getElementById('board');

  const center = document.getElementById('board-center');



  // We'll place cells using grid positioning

  // Bottom row: row 11, cols 1-11

  BOARD_BOTTOM.forEach((d, i) => {

    const cell = buildCell(d, i === 0 ? '' : i === 10 ? '' : 'bottom');

    cell.style.gridColumn = (i + 1).toString();

    cell.style.gridRow = '11';

    board.insertBefore(cell, center);

  });



  // Left column: col 1, rows 10-2 (going up)

  BOARD_LEFT.forEach((d, i) => {

    const cell = buildCell(d, 'left');

    cell.style.gridColumn = '1';

    cell.style.gridRow = (10 - i).toString();

    board.insertBefore(cell, center);

  });



  // Top row: row 1, cols 11-1 (right to left)

  BOARD_TOP.forEach((d, i) => {

    const cell = buildCell(d, i === 0 ? '' : i === 10 ? '' : 'top');

    cell.style.gridColumn = (11 - i).toString();

    cell.style.gridRow = '1';

    board.insertBefore(cell, center);

  });



  // Right column: col 11, rows 2-10 (going up from bottom-right)

  BOARD_RIGHT.forEach((d, i) => {

    const cell = buildCell(d, 'right');

    cell.style.gridColumn = '11';

    cell.style.gridRow = (10 - i).toString();

    board.insertBefore(cell, center);

  });



  // Render center legend

  const legend = document.getElementById('center-legend');

  Object.entries(ZONES).forEach(([key, z]) => {

    legend.innerHTML += `<div class="leg-item" onclick="showZoneModal('${key}')">

      <div class="leg-dot" style="background:${z.color}"></div>

      <span>${z.invest}</span>

    </div>`;

  });

}



